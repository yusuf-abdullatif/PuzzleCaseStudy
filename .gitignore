# =============================================================================
# Unreal Engine 5 – PuzzleCaseStudy .gitignore
# Based on GitHub's UnrealEngine.gitignore, extended for IDE / OS / local tools.
# =============================================================================

# -----------------------------------------------------------------------------
# Visual Studio / MSVC
# -----------------------------------------------------------------------------
.vs/
*.VC.db
*.VC.opendb
*.suo
*.opensdf
*.sdf
*.user
*.userosscache
*.sln.docstates
*.rsuser

# These project files are regenerated by Unreal ("Generate Visual Studio project files")
*.sln
*.xcodeproj
*.xcworkspace
.vsconfig

# -----------------------------------------------------------------------------
# JetBrains / Rider / VS Code
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.DotSettings.user

# -----------------------------------------------------------------------------
# Compiled object / library / executable artifacts
# -----------------------------------------------------------------------------
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.mod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa

# -----------------------------------------------------------------------------
# Unreal Engine generated / local folders
# -----------------------------------------------------------------------------
Binaries/
Plugins/**/Binaries/
Intermediate/
Plugins/**/Intermediate/
DerivedDataCache/
Saved/
Crashes/
Autosaves/

# Packaging / cook output (keep selective Build exceptions below)
Build/*

# Whitelist PakBlacklist-*.txt and icons under Build
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Built data for maps (regenerated by the editor)
*_BuiltData.uasset

# Precompiled SourceArt (if you add such a folder later)
SourceArt/**/*.png
SourceArt/**/*.tga

# Local/feature packs / temporary content caches
Content/Collections/
Content/Developers/

# -----------------------------------------------------------------------------
# Logs / temp / Python bytecode
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*.pyc
*.pyo
*.pyd
__pycache__/

# -----------------------------------------------------------------------------
# OS junk
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
.directory
.nfs*

# -----------------------------------------------------------------------------
# Optional local secrets / env (keep out of the delivery repo)
# -----------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
